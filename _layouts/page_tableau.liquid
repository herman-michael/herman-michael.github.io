---
layout: tableau
---

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<header class="tableau-fullpage">
  {{ content }}
</article>

{% if page.related_publications %}
  <h2>References</h2>
  <div class="publications">
    {% bibliography --cited_in_order %}
  </div>
{% endif %}

{% if site.giscus and page.giscus_comments %}
  {% include giscus.liquid %}
{% endif %}