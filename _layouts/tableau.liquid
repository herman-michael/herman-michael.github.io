<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% if page.redirect %}
      {% assign redirect = page.redirect contains '://' 
        | default: page.redirect | relative_url %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    <style>
      html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        overflow-x: hidden;
      }
      .full-width {
        width: 100%;
        margin: 0;
        padding: 0;
      }
      .tableau-full-width {
        width: 100vw;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    {% include header.liquid %}

    <!-- Constrained content area -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <div class="col-sm-9">{{ content }}</div>
            <div class="col-sm-3"><nav id="toc-sidebar" class="sticky-top"></nav></div>
          </div>
        {% else %}
          <div class="row">
            <div class="col-sm-3"><nav id="toc-sidebar" class="sticky-top"></nav></div>
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Full-width Tableau embed -->
    {% if page.tableau_embed %}
      <div class="tableau-full-width">
        {{ page.tableau_embed }}
      </div>
    {% endif %}

    {% include footer.liquid %}
    <script type="module" src="https://public.tableau.com/javascripts/api/tableau.embedding.3.latest.js"></script>
    {% include scripts.liquid %}
  </body>
</html>
